{
  "name": "hanzo-finance-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Hanzo Finance — Go umbrella (native ledger, embedded in cloud) + web (finance.hanzo.ai) + @hanzo/finance-ui.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm --filter @hanzo/finance-ui build && pnpm --filter @hanzo/finance-web build",
    "test": "pnpm --filter @hanzo/finance-ui test",
    "typecheck": "pnpm --filter @hanzo/finance-ui typecheck && pnpm --filter @hanzo/finance-web typecheck"
  },
  "pnpm": {
    "overrides": {
      "react-native-web": "0.21.2"
    }
  }
}
